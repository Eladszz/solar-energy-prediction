@startuml sequence_diagram_logical
autonumber
skinparam style strictuml
title Energy Forecast Simulation – Logical Sequence Diagram

actor "User" as user
participant "User Interface" as ui
participant "Forecast Controller" as controller
participant "Loss Calculation" as loss
participant "Weather Data Provider" as weather
participant "Forecast Engine" as engine

user -> ui : Initiate forecast request
activate ui

ui -> controller : Request energy forecast
activate controller

controller -> loss : Calculate system loss factors
loss --> controller : Loss parameters

controller -> weather : Retrieve weather data
weather --> controller : Weather information

controller -> engine : Compute energy forecast
note right of engine
  Forecast Engine supports:
  - Physical models (implemented)
  - ML-based models (planned)
end note
engine --> controller : Forecast results

controller --> ui : Forecast results
ui --> user : Display forecast results

@enduml
