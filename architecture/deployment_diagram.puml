@startuml
node "User Device" { [Browser] }
node "Docker Container :8000" { [FastAPI / Uvicorn]; [Built React Assets]; [Physical PV Services] }
cloud "Open-Meteo" as Weather
cloud "OpenStreetMap / Nominatim" as Maps
[Browser] --> [FastAPI / Uvicorn] : UI + JSON API
[FastAPI / Uvicorn] --> [Built React Assets]
[FastAPI / Uvicorn] --> [Physical PV Services]
[Physical PV Services] --> Weather : HTTPS
[Browser] --> Maps : HTTPS
@enduml
