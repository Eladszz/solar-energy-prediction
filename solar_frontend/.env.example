# Optional override for the FastAPI backend URL used by the React frontend.
# Leave unset for same-origin deployments such as the Docker image.
VITE_API_BASE_URL="http://127.0.0.1:8000"

# Optional override for the Vite development proxy target.
# If omitted, the proxy uses VITE_API_BASE_URL and then falls back to http://127.0.0.1:8000.
VITE_API_PROXY_TARGET="http://127.0.0.1:8000"
